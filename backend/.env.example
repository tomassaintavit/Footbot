# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-de-supabase

# Configuración de IA (Ollama local o Groq Cloud)
# Si dejas GROQ_API_KEY vacío, se usará Ollama en localhost:11434
GROQ_API_KEY=gsk_xxx...

# Configuración de Telegram Bot
# Obtén un token de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu-token-de-telegram-bot

# Torneo Golden API
# Obtené estos IDs desde la app de Torneo Golden
GOLDEN_API_BASE=https://torneo-golden-backend-production.up.railway.app
GOLDEN_TORNEO_ID=id-del-torneo-activo
GOLDEN_EQUIPO_ID=id-de-buen-palo

# Nota: No compartas tu .env real en GitHub. 
# Copia este archivo como .env y completa los valores reales.

